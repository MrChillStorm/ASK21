<?xml version="1.0" encoding="utf-8" ?>
<PropertyList>
	<path>ask21.ac</path>
	<nasal>
		<load>
			var livery_update = aircraft.livery_update.new("Aircraft/ASK21_v9/Models/Liveries", 5);

			var self = cmdarg();

			<!-- INTEGERS -->
			self.getNode("sim/model/livery/show-immat",	1).alias( self.getNode("sim/multiplay/generic/int[6]") );
			self.getNode("controls/smoke",			1).alias( self.getNode("sim/multiplay/generic/int[7]") );
			self.getNode("gear/gear[0]/wow",			1).alias( self.getNode("sim/multiplay/generic/int[8]") );
			self.getNode("gear/gear[1]/wow",			1).alias( self.getNode("sim/multiplay/generic/int[9]") );
			self.getNode("gear/gear[2]/wow",			1).alias( self.getNode("sim/multiplay/generic/int[10]") );
			self.getNode("sim/model/variant",			1).alias( self.getNode("sim/multiplay/generic/int[11]") );

			<!-- MI variant only -->
			self.getNode("engines/engine[0]/running",		1).alias( self.getNode("sim/multiplay/generic/int[12]") );
			self.getNode("engines/engine[0]/cranking",	1).alias( self.getNode("sim/multiplay/generic/int[13]") );

			<!-- FLOATS -->
			self.getNode("sim/model/door-positions/canopyF/position-norm",  1).alias( self.getNode("sim/multiplay/generic/float[0]") );
			self.getNode("sim/model/door-positions/canopyFJ/position-norm", 1).alias( self.getNode("sim/multiplay/generic/float[1]") );
			self.getNode("sim/model/door-positions/canopyB/position-norm",  1).alias( self.getNode("sim/multiplay/generic/float[2]") );
			self.getNode("sim/model/door-positions/frontwin/position-norm", 1).alias( self.getNode("sim/multiplay/generic/float[3]") );
			self.getNode("sim/model/door-positions/rearwin/position-norm",  1).alias( self.getNode("sim/multiplay/generic/float[4]") );
			self.getNode("gear/gear[0]/rollspeed-ms", 	1).alias( self.getNode("sim/multiplay/generic/float[5]") );
			self.getNode("gear/gear[1]/rollspeed-ms", 	1).alias( self.getNode("sim/multiplay/generic/float[6]") );
			self.getNode("gear/gear[2]/rollspeed-ms", 	1).alias( self.getNode("sim/multiplay/generic/float[7]") );
			self.getNode("sim/systems/wingflexer/z-m", 	1).alias( self.getNode("sim/multiplay/generic/float[8]") );

			<!-- MI variant only -->
			self.getNode("engines/engine/prop-pos-norm",		1).alias( self.getNode("sim/multiplay/generic/float[10]") );
			self.getNode("controls/engines/engine[0]/throttle",	1).alias( self.getNode("sim/multiplay/generic/float[11]") );
			self.getNode("engines/engine[0]/mp-osi",			1).alias( self.getNode("sim/multiplay/generic/float[12]") );

			self.getNode("/sim/model/sound/wind-volume-front",	1).alias( self.getNode("sim/multiplay/generic/float[13]") );
			self.getNode("/sim/model/sound/wind-volume-rear",	1).alias( self.getNode("sim/multiplay/generic/float[14]") );
		</load>
		<unload>
			livery_update.stop();

			self.getNode("sim/model/livery/show-immat",	1).unalias();
			self.getNode("controls/smoke",			1).unalias();
			self.getNode("gear/gear[0]/wow",			1).unalias();
			self.getNode("gear/gear[1]/wow",			1).unalias();
			self.getNode("gear/gear[2]/wow",			1).unalias();
			self.getNode("sim/model/variant",			1).unalias();
			self.getNode("engines/engine[0]/running",		1).unalias();
			self.getNode("engines/engine[0]/cranking",	1).unalias();
			self.getNode("sim/model/door-positions/canopyF/position-norm",  1).unalias();
			self.getNode("sim/model/door-positions/canopyFJ/position-norm", 1).unalias();
			self.getNode("sim/model/door-positions/canopyB/position-norm",  1).unalias();
			self.getNode("sim/model/door-positions/frontwin/position-norm", 1).unalias();
			self.getNode("sim/model/door-positions/rearwin/position-norm",  1).unalias();
			self.getNode("gear/gear[0]/rollspeed-ms", 	1).unalias();
			self.getNode("gear/gear[1]/rollspeed-ms", 	1).unalias();
			self.getNode("gear/gear[2]/rollspeed-ms", 	1).unalias();
			self.getNode("sim/systems/wingflexer/z-m", 	1).unalias();
			self.getNode("engines/engine/prop-pos-norm",		1).unalias();
			self.getNode("controls/engines/engine[0]/throttle",	1).unalias();
			self.getNode("engines/engine[0]/mp-osi",			1).unalias();
			self.getNode("/sim/model/sound/wind-volume-front",	1).unalias();
			self.getNode("/sim/model/sound/wind-volume-rear",	1).unalias();
		</unload>
	</nasal>

