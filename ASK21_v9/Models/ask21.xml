	<!--	CANOPY	-->
	<animation>
		<type>pick</type>
		<object-name>canopy.F.frame</object-name>
		<visible>true</visible>
		<action>
			<button>0</button>
			<repeatable>false</repeatable>
			<binding>
				<command>nasal</command>
				<script>doors.canopyF.toggle();</script>
			</binding>
		</action>
	</animation>
	<animation>
		<type>rotate</type>
		<object-name>canopy.F.frame</object-name>
		<object-name>canopy.F.glass</object-name>
		<property>sim/model/door-positions/canopyF/position-norm</property>
		<interpolation>
			<entry>
				<ind>0.0</ind>
				<dep>0</dep>
			</entry>
			<entry>
				<ind>0.2</ind>
				<dep>0</dep>
			</entry>
			<entry>
				<ind>1</ind>
				<dep>-50</dep>
			</entry>
		</interpolation>
		<axis>
			<y>1</y>
		</axis>
		<center>
			<x-m>-3.56113</x-m>
			<z-m>0.82</z-m>
		</center>
	</animation>

	<!--Canopy Front Jettison-->
	<animation>
		<type>translate</type>
		<object-name>canopy.F.frame</object-name>
