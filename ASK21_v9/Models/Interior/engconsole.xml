<?xml version="1.0" encoding="utf-8" ?>
<PropertyList>
	<path>engconsole.ac</path>

	<!--Throttle Handle-->
	<animation>
		<type>knob</type>
		<object-name>throttle</object-name>
		<drag-direction>vertical</drag-direction>
		<property>controls/engines/engine/throttle-int</property>
		<factor>-41</factor>
		<center>
			<x-m>-0.037</x-m>
		</center>
		<axis>
			<y>1</y>
		</axis>
		<action>
			<binding>
				<command>property-adjust</command>
				<property>controls/engines/engine/throttle-int</property>
				<factor>0.05</factor>
				<min>0</min>
				<max>1</max>
			</binding>
			<binding>
				<condition>
					<property>controls/ask21/mixture-to-throttle</property>
				</condition>
				<command>property-adjust</command>
				<property>controls/engines/engine/mixture</property>
				<factor>0.05</factor>
				<min>0</min>
				<max>1</max>
			</binding>
			<binding>
				<condition>
					<not>
						<property>controls/ask21/throttle-to-airbrake</property>
					</not>
				</condition>
				<command>property-adjust</command>
				<property>controls/engines/engine/throttle</property>
				<factor>0.05</factor>
				<min>0</min>
				<max>1</max>
			</binding>
		</action>
		<hovered>
			<binding>
				<command>set-tooltip</command>
				<tooltip-id>thr</tooltip-id>
				<label>Throttle %s%%</label>
				<mapping>percent</mapping>
				<property>controls/engines/engine/throttle-int</property>
			</binding>
		</hovered>
	</animation>

	<!--	Propeller Brake Handle -->
	<animation>
		<type>knob</type>
		<object-name>propbrake</object-name>
		<drag-direction>vertical</drag-direction>
		<property>controls/engines/engine/propeller-brake</property>
		<factor>27</factor>
		<center>
			<x-m>-0.037</x-m>
		</center>
		<axis>
			<y>1</y>
		</axis>
		<action>
			<binding>
				<command>property-adjust</command>
				<property>controls/engines/engine/propeller-brake</property>
				<factor>-0.05</factor>
				<min>0</min>
				<max>1</max>
			</binding>
		</action>
		<hovered>
			<binding>
				<command>set-tooltip</command>
				<tooltip-id>prb</tooltip-id>
				<label>Propeller Brake %s%%</label>
				<mapping>percent</mapping>
				<property>controls/engines/engine/propeller-brake</property>
			</binding>
		</hovered>
	</animation>

	<!--Engine starter-->
	<animation>
		<type>pick</type>
		<object-name>starter</object-name>
		<action>
			<button>0</button>
			<repeatable>false</repeatable>
			<binding>
				<command>property-assign</command>
				<property>controls/engines/engine/starter-btn</property>
				<value>1</value>
			</binding>
			<mod-up>
				<binding>
					<command>property-assign</command>
					<property>controls/engines/engine/starter-btn</property>
					<value>0</value>
				</binding>
			</mod-up>
		</action>
		<hovered>
			<binding>
				<command>set-tooltip</command>
				<tooltip-id>str</tooltip-id>
				<label>Starter: %s</label>
				<mapping>on-off</mapping>
				<property>controls/engines/engine/starter</property>
			</binding>
		</hovered>
	</animation>
	<animation>
		<type>translate</type>
		<object-name>starter</object-name>
		<property>controls/engines/engine/starter-btn</property>
		<factor>-0.002</factor>
		<axis>
			<x>1</x>
		</axis>
	</animation>


	<!--Engine electric master switch-->
	<animation>
		<type>pick</type>
		<object-name>masterswitch</object-name>
		<action>
			<button>0</button>
			<repeatable>false</repeatable>
			<binding>
				<command>property-toggle</command>
				<property>controls/electric/engine-battery-switch</property>
			</binding>
		</action>
		<hovered>
			<binding>
				<command>set-tooltip</command>
				<tooltip-id>str</tooltip-id>
				<label>Engine Electric Master: %s</label>
				<mapping>on-off</mapping>
				<property>controls/electric/engine-battery-switch</property>
			</binding>
		</hovered>
	</animation>
	<animation>
		<type>rotate</type>
		<object-name>masterswitch</object-name>
		<property>controls/electric/engine-battery-switch-pos</property>
		<factor>-45</factor>
		<center>
			<y-m>-0.0054</y-m>
			<z-m> 0.0114</z-m>
		</center>
		<axis>
			<x>1</x>
		</axis>
	</animation>
</PropertyList>
