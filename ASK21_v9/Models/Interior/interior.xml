<?xml version="1.0" encoding="utf-8" ?>
<PropertyList>
	<path>interior.ac</path>

	<!-- Yaw Strings -->
	<model>
		<name>yawstring.F</name>
		<path>Aircraft/Instruments-3d/glider/wool-thread/wool-thread.xml</path>
		<offsets>
			<x-m>-3.43276</x-m>
			<y-m> 0</y-m>
			<z-m>0.88</z-m>
			<pitch-deg>22</pitch-deg>
		</offsets>
	</model>
	<model>
		<name>yawstring.R</name>
		<path>Aircraft/Instruments-3d/glider/wool-thread/wool-thread.xml</path>
