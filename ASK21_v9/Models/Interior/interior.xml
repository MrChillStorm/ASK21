	<!-- Airbrake Handles -->
	<animation>
		<type>slider</type>
		<object-name>airbrake-front</object-name>
		<object-name>airbrake-rear</object-name>
		<action>
			<button>0</button>
			<repeatable>false</repeatable>
			<binding>
				<condition>
					<equals>
						<property>sim/model/variant</property>
						<value>0</value>
					</equals>
				</condition>
				<command>property-adjust</command>
				<property>controls/engines/engine/throttle</property>
				<factor>0.05</factor>
				<min>0</min>
				<max>1</max>
			</binding>
			<binding>
				<condition>
					<equals>
						<property>sim/model/variant</property>
						<value>1</value>
					</equals>
				</condition>
				<command>property-adjust</command>
				<property>controls/flight/spoilers</property>
				<factor>0.05</factor>
				<min>0</min>
				<max>1</max>
			</binding>
		</action>
		<hovered>
			<binding>
				<condition>
					<equals>
						<property>sim/model/variant</property>
						<value>0</value>
					</equals>
				</condition>
				<command>set-tooltip</command>
				<tooltip-id>airbrake</tooltip-id>
				<label>%s</label>
				<mapping>nasal</mapping>
				<property>controls/engines/engine/throttle</property>
				<script>
					return sprintf("Speedbrake %d%% out", 100-arg[0]*100);
				</script>
			</binding>
			<binding>
				<condition>
					<equals>
						<property>sim/model/variant</property>
						<value>1</value>
					</equals>
				</condition>
				<command>set-tooltip</command>
				<tooltip-id>airbrake-mi</tooltip-id>
				<label>%s</label>
				<mapping>nasal</mapping>
				<property>controls/flight/spoilers</property>
				<script>
					return sprintf("Speedbrake %d%% out", 100-arg[0]*100);
				</script>
			</binding>
		</hovered>
	</animation>
	<animation>
		<type>translate</type>
		<object-name>airbrake-front</object-name>
		<property>surface-positions/speedbrake-pos-norm</property>
		<factor>0.21</factor>
		<axis>
			<x1-m>-3.10624</x1-m>
			<y1-m>-0.24893</y1-m>
			<z1-m>0.47521</z1-m>
			<x2-m>-2.81179</x2-m>
			<y2-m>-0.27476</y2-m>
			<z2-m>0.53454</z2-m>
		</axis>
	</animation>
	<animation>
		<type>translate</type>
		<object-name>airbrake-rear</object-name>
		<property>surface-positions/speedbrake-pos-norm</property>
		<factor>0.21</factor>
		<axis>
			<x1-m>-2.17081</x1-m>
			<y1-m>-0.27942</y1-m>
			<z1-m>0.58221</z1-m>
			<x2-m>-1.87227</x2-m>
			<y2-m>-0.29</y2-m>
			<z2-m>0.62263</z2-m>
		</axis>
	</animation>

