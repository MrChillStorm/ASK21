			</equals>
		</condition>
		<offsets>
			<x-m>-3.27 </x-m>
			<y-m> 0.0  </y-m>
			<z-m> 0.647</z-m>
			<pitch-deg>-5</pitch-deg>
		</offsets>
	</model>
	<model>
