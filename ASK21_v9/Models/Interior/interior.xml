		</offsets>
	</model>
	<model>
		<name>panelRmi</name>
		<path>Panel/panelR-mi.xml</path>
		<condition>
			<equals>
				<property>sim/model/variant</property>
				<value>1</value>
			</equals>
		</condition>
		<offsets>
			<x-m> -2.19  </x-m>
			<z-m>  0.745 </z-m>
			<pitch-deg>-5.5</pitch-deg>
		</offsets>
	</model>

	<!-- Engine Consoles, only present in -mi -->
