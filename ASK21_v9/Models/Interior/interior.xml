		</offsets>
	</model>
	<model>
		<name>engconsole-rear</name>
		<path>engconsole-rear.xml</path>
		<condition>
			<equals>
				<property>sim/model/variant</property>
				<value>1</value>
			</equals>
		</condition>
		<offsets>

			<x-m> -2.19  </x-m>
			<z-m>  0.745 </z-m>
