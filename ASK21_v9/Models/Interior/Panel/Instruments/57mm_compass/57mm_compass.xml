<?xml version="1.0" encoding="utf-8" ?>
<PropertyList>
	<path>57mm_compass.ac</path>
	
	<params>
		<heading-deg type="string">instrumentation/magnetic-compass/indicated-heading-deg</heading-deg>
		<light type="string">sim/model/instruments-light</light>
	</params>
	
	<animation>
		<type>material</type>
		<object-name>scala</object-name>
		<emission>
			<red>0.28</red>
			<green>0.14</green>
			<blue>0.07</blue>
			<factor-prop alias="/params/light" />
		</emission>
	</animation>
	
	<animation>
		<type>rotate</type>
		<object-name>scala</object-name>
		<property alias="/params/heading-deg" />
		<axis>
			<z>1</z>
		</axis>
		<center>
			<x-m>-0.025</x-m>
		</center>
	</animation>
</PropertyList>
