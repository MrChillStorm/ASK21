<?xml version="1.0" encoding="utf-8" ?>
<PropertyList>
	<path>winter-asi.ac</path>
	
	<params>
		<airspeed-kt type="string">instrumentation/airspeed-indicator/indicated-corr-speed-kt</airspeed-kt>
		<ac-variant type="string">sim/model/variant</ac-variant>
		<instr-variant type="string">sim/model/livery/instruments/asi</instr-variant>
		<light type="string">sim/model/instruments-light</light>
	</params>
	
	<effect>
		<inherits-from>Models/Effects/instrument-glass</inherits-from>
		<object-name>asi.glass</object-name>
	</effect>
	
	<!-- Illumination -->
	<animation>
		<type>material</type>
		<object-name>asi.face</object-name>
		<object-name>asi.needle</object-name>
		<emission>
			<red>0.28</red>
			<green>0.14</green>
			<blue>0.07</blue>
			<factor-prop alias="/params/light" />
		</emission>
	</animation>
	<!-- Select Face to be shown -->
	<animation>
		<type>texmultiple</type>
		<object-name>asi.face</object-name>
		<transform>
			<subtype>textranslate</subtype>
			<property alias="/params/instr-variant" />
			<factor>0.5</factor>
			<axis>
				<x>1</x>
			</axis>
		</transform>
		<transform>
			<subtype>textranslate</subtype>
			<property alias="/params/ac-variant" />
			<factor>0.5</factor>
			<axis>
				<y>1</y>
			</axis>
		</transform>
	</animation>
	
	<!-- Needle Animation -->
	<!-- NOTE: KT and KPH Needles need to be separate objects, switching via conditions in the rotate animations causes problems
		when changing liveries while airspeed is non-zero	-->
	<animation>
		<type>select</type>
		<object-name>asi.needle.kph</object-name>
		<condition>
			<equals>
				<property alias="/params/instr-variant" />
				<value>0</value> <!-- unit kph -->
			</equals>
		</condition>
	</animation>
	<animation>
		<type>select</type>
		<object-name>asi.needle.kts</object-name>
		<condition>
			<equals>
				<property alias="/params/instr-variant" />
				<value>1</value> <!-- unit kts -->
			</equals>
		</condition>
	</animation>
	<animation>
		<type>rotate</type>
		<object-name>asi.needle.kph</object-name>
		<property alias="/params/airspeed-kt" />
		<!-- factor 1.852 for 1 knot to 1 km/h -->
		<!-- 0 - 27 knot = 0 - 50 km/h -->
		<!-- 27 - 162 knot = 50 - 300 km/h -->
		<!--Calibrated for new texture-->
		<interpolation>
			<entry><!--added for beta false indication-->
				<ind> -162</ind>
				<dep>-510</dep>
			</entry>
			<entry>
				<ind>  0.0</ind>
				<dep>  0  </dep>
			</entry>
