<?xml version="1.0"?>
<!--
	LXNAV V8 vario indicator (front part), screen drawn by Nasal/Canvas (lxv8.nas).
	Mesh generated by src/make_model.py from the dimensions in the V8 installation manual.
-->
<PropertyList>
	<name>lxv8</name>
	<path>lxv8.ac</path>

	<!-- the screws of all instruments: those of the Winter ASI, on the front face of the housing -->
	<model>
		<name>lxv8_screws</name>
		<path>../GMeter/57mm_screws.xml</path>
		<offsets>
			<x-m>0.0100</x-m>
		</offsets>
	</model>

	<!-- the screen is self-luminous; brightness follows the ambient light (see lxv8.nas) -->
	<animation>
		<type>material</type>
		<object-name>V8.screen</object-name>
		<emission>
			<red>1</red>
			<green>1</green>
			<blue>1</blue>
			<factor-prop>/instrumentation/lxv8/brightness</factor-prop>
		</emission>
	</animation>
	<effect>
		<inherits-from>Effects/model-interior-display</inherits-from>
		<object-name>V8.screen</object-name>
		<parameters>
			<dirt-factor>1.0</dirt-factor>
			<contrast>0.75</contrast>
		</parameters>
	</effect>

	<!-- click on the screen: a window with the screen for a closer look -->
	<animation>
		<type>pick</type>
		<object-name>V8.screen</object-name>
		<action>
			<button>0</button>
			<binding>
				<command>nasal</command>
				<script>lxv8.toggle_window()</script>
			</binding>
		</action>
	</animation>

	<!-- the three push buttons: top, middle (mode, long press = setup), bottom -->
	<animation>
		<type>pick</type>
		<object-name>V8.btn.up</object-name>
		<action>
			<button>0</button>
			<binding>
				<command>property-assign</command>
				<property>/instrumentation/lxv8/inputs/btn-up</property>
				<value>1</value>
			</binding>
			<mod-up>
				<binding>
					<command>property-assign</command>
					<property>/instrumentation/lxv8/inputs/btn-up</property>
					<value>0</value>
				</binding>
			</mod-up>
		</action>
	</animation>
	<animation>
		<type>pick</type>
		<object-name>V8.btn.mid</object-name>
		<action>
			<button>0</button>
			<binding>
				<command>property-assign</command>
				<property>/instrumentation/lxv8/inputs/btn-mid</property>
				<value>1</value>
			</binding>
			<mod-up>
				<binding>
					<command>property-assign</command>
					<property>/instrumentation/lxv8/inputs/btn-mid</property>
					<value>0</value>
				</binding>
			</mod-up>
		</action>
	</animation>
	<animation>
		<type>pick</type>
		<object-name>V8.btn.dn</object-name>
		<action>
			<button>0</button>
			<binding>
				<command>property-assign</command>
				<property>/instrumentation/lxv8/inputs/btn-dn</property>
				<value>1</value>
			</binding>
			<mod-up>
				<binding>
					<command>property-assign</command>
					<property>/instrumentation/lxv8/inputs/btn-dn</property>
					<value>0</value>
				</binding>
			</mod-up>
		</action>
	</animation>
	<animation>
		<type>translate</type>
		<object-name>V8.btn.up</object-name>
		<property>/instrumentation/lxv8/inputs/btn-up</property>
		<axis><x>1</x></axis>
		<factor>-0.0012</factor>
	</animation>
	<animation>
		<type>translate</type>
		<object-name>V8.btn.mid</object-name>
		<property>/instrumentation/lxv8/inputs/btn-mid</property>
		<axis><x>1</x></axis>
		<factor>-0.0012</factor>
	</animation>
	<animation>
		<type>translate</type>
		<object-name>V8.btn.dn</object-name>
		<property>/instrumentation/lxv8/inputs/btn-dn</property>
		<axis><x>1</x></axis>
		<factor>-0.0012</factor>
	</animation>

</PropertyList>
