<?xml version="1.0"?>

<PropertyList>

	<path>ilec.ac</path>

	<animation>
		<type>pick</type>
		<object-name>cycledisplay</object-name>
		<action>
			<button>0</button>
			<binding>
				<command>nasal</command>
				<script>
					ilec.cycle_display();
				</script>
			</binding>
			<binding>
				<command>property-assign</command>
				<property>instrumentation/ilec/cycle-display-btn</property>
				<value>1</value>
			</binding>
			<mod-up>
				<binding>
					<command>property-assign</command>
					<property>instrumentation/ilec/cycle-display-btn</property>
					<value>0</value>
				</binding>
			</mod-up>
		</action>
	</animation>
	<animation>
		<type>translate</type>
		<object-name>cycledisplay</object-name>
		<property>instrumentation/ilec/cycle-display-btn</property>
		<factor>-0.002</factor>
		<axis>
			<x>1</x>
		</axis>
	</animation>

	<animation>
		<type>pick</type>
		<object-name>ignitionswitch</object-name>
		<action>
			<button>0</button>
			<binding>
				<command>property-cycle</command>
				<property>controls/engines/engine/magnetos</property>
				<value>3</value>
				<value>0</value>
			</binding>
		</action>
	</animation>
	<animation>
		<type>rotate</type>
		<object-name>ignitionswitch</object-name>
		<property>controls/engines/engine/magnetos</property>
		<factor>-15</factor>
		<center>
			<x-m> 0.0012</x-m>
			<z-m>-0.014 </z-m>
		</center>
		<axis>
			<y>1</y>
		</axis>
	</animation>

	<animation>
		<type>pick</type>
		<object-name>propes</object-name>
		<action>
			<button>0</button>
			<binding>
				<command>property-toggle</command>
				<property>controls/engines/engine/extend-propeller</property>
			</binding>
		</action>
	</animation>
	<animation>
		<type>rotate</type>
		<object-name>propes</object-name>
		<property>controls/engines/engine/extend-propeller-pos</property>
		<factor>-40</factor>
		<center>
			<x-m>0.0006</x-m>
		</center>
		<axis>
			<y>1</y>
		</axis>
	</animation>


	<!--RPM Lights-->
	<animation>
		<type>material</type>
		<condition>
			<greater-than>
				<property>engines/engine/engine-rpm</property>
				<value>3000</value>
			</greater-than>
			<less-than-equals>
				<property>engines/engine/engine-rpm</property>
				<value>7000</value>
			</less-than-equals>
		</condition>
		<object-name>rpm.green</object-name>
		<emission>
			<red>0</red>
			<green>1</green>
			<blue>0</blue>
			<factor-prop>/controls/electric/battery-switch</factor-prop>
		</emission>
	</animation>
	<animation>
		<type>material</type>
		<condition>
			<greater-than>
				<property>engines/engine/engine-rpm</property>
				<value>7000</value>
			</greater-than>
			<less-than-equals>
				<property>engines/engine/engine-rpm</property>
				<value>7700</value>
			</less-than-equals>
		</condition>
		<object-name>rpm.yellow</object-name>
		<emission>
			<red>1</red>
			<green>1</green>
			<blue>0</blue>
			<factor-prop>/controls/electric/battery-switch</factor-prop>
		</emission>
	</animation>
	<animation>
		<type>material</type>
		<condition>
			<greater-than>
				<property>engines/engine/engine-rpm</property>
				<value>7800</value>
			</greater-than>
		</condition>
		<object-name>rpm.red</object-name>
		<emission>
			<red>1</red>
			<green>0</green>
			<blue>0</blue>
			<factor-prop>/controls/electric/battery-switch</factor-prop>
		</emission>
	</animation>

	<!--Warning Light (red)-->
	<!--Ignition Off while starting-->
	<animation>
		<type>material</type>
		<condition>
			<equals>
				<property>controls/engines/engine/magnetos</property>
				<value>0</value>
			</equals>
			<property>controls/engines/engine/starter</property>
		</condition>
		<object-name>ignitionoff</object-name>
		<emission>
			<red>1</red>
			<green>0</green>
			<blue>0</blue>
			<factor-prop>/controls/electric/battery-switch</factor-prop>
		</emission>
	</animation>
	<!--Propeller not fully extended-->
	<animation>
		<type>material</type>
		<condition>
			<greater-than>
				<property>sim/multiplay/generic/float[10]</property>
				<value>0</value>
			</greater-than>
			<less-than>
				<property>sim/multiplay/generic/float[10]</property>
				<value>1</value>
			</less-than>
		</condition>
		<object-name>propnfe</object-name>
		<emission>
			<red>1</red>
			<green>0</green>
			<blue>0</blue>
			<factor-prop>/controls/electric/battery-switch</factor-prop>
		</emission>
	</animation>
	<!--ECU fail-->
	<animation>
		<type>material</type>
		<condition>
			<greater-than>
				<property>engines/engine/ecu-fail</property>
				<value>0</value>
			</greater-than>
		</condition>
		<object-name>ecu</object-name>
		<emission>
			<red>1</red>
			<green>0</green>
			<blue>0</blue>
			<factor-prop>/controls/electric/battery-switch</factor-prop>
		</emission>
	</animation>
	<!--Generator warning-->
	<animation>
		<type>material</type>
		<condition>
			<and>
				<equals>
					<property>sim/multiplay/generic/float[10]</property>
					<value>1</value>
				</equals>
				<or>
					<less-than>
						<property>engines/engine/engine-rpm</property>
						<value>2000</value>
					</less-than>
					<less-than>
						<property>systems/electrical/eng-volts</property>
						<value>12.8</value>
					</less-than>
				</or>
			</and>
		</condition>
		<object-name>genwarn</object-name>
		<emission>
			<red>1</red>
			<green>0</green>
			<blue>0</blue>
			<factor-prop>/controls/electric/battery-switch</factor-prop>
		</emission>
	</animation>

	<!--Green: correct state-->
	<!--Propeller fully extended-->
	<animation>
		<type>material</type>
		<condition>
			<equals>
				<property>sim/multiplay/generic/float[10]</property>
				<value>1</value>
			</equals>
		</condition>
		<object-name>propfe</object-name>
		<emission>
			<red>0</red>
			<green>1</green>
			<blue>0</blue>
			<factor-prop>/controls/electric/battery-switch</factor-prop>
		</emission>
	</animation>
	<!--Propeller not fully retracted-->
	<animation>
		<type>material</type>
		<condition>
			<equals>
				<property>sim/multiplay/generic/float[10]</property>
				<value>0</value>
			</equals>
		</condition>
		<object-name>propfr</object-name>
		<emission>
			<red>0</red>
			<green>1</green>
			<blue>0</blue>
			<factor-prop>/controls/electric/battery-switch</factor-prop>
		</emission>
	</animation>

	<!-- Engine Hour Meter -->
	<animation>
		<type>rotate</type>
		<object-name>hours.001</object-name>
		<property>instrumentation/ilec/hours</property>
		<factor>3600</factor>
		<center>
			<x-m>-0.008 </x-m>
			<z-m>-0.0148</z-m>
		</center>
		<axis>
			<y>1</y>
		</axis>
	</animation>
	<animation>
		<type>rotate</type>
		<object-name>hours.01</object-name>
		<property>instrumentation/ilec/hours</property>
		<factor>360</factor>
		<center>
			<x-m>-0.008 </x-m>
			<z-m>-0.0148</z-m>
		</center>
		<axis>
			<y>1</y>
		</axis>
	</animation>
	<animation>
		<type>rotate</type>
		<object-name>hours.1</object-name>
		<property>instrumentation/ilec/hours</property>
		<factor>36</factor>
		<center>
			<x-m>-0.008 </x-m>
			<z-m>-0.0148</z-m>
		</center>
		<axis>
			<y>1</y>
		</axis>
	</animation>
	<animation>
		<type>rotate</type>
		<object-name>hours.10</object-name>
		<property>instrumentation/ilec/hours</property>
		<factor>3.6</factor>
		<center>
			<x-m>-0.008 </x-m>
			<z-m>-0.0148</z-m>
		</center>
		<axis>
			<y>1</y>
		</axis>
	</animation>
	<animation>
		<type>rotate</type>
		<object-name>hours.100</object-name>
		<property>instrumentation/ilec/hours</property>
		<factor>0.36</factor>
		<center>
			<x-m>-0.008 </x-m>
			<z-m>-0.0148</z-m>
		</center>
		<axis>
			<y>1</y>
		</axis>
	</animation>
	<animation>
		<type>rotate</type>
		<object-name>hours.1000</object-name>
		<property>instrumentation/ilec/hours</property>
		<factor>0.036</factor>
		<center>
			<x-m>-0.008 </x-m>
			<z-m>-0.0148</z-m>
		</center>
		<axis>
			<y>1</y>
		</axis>
	</animation>
	<animation>
		<type>rotate</type>
		<object-name>hours.10000</object-name>
		<property>instrumentation/ilec/hours</property>
		<factor>0.0036</factor>
		<center>
			<x-m>-0.008 </x-m>
			<z-m>-0.0148</z-m>
		</center>
		<axis>
			<y>1</y>
		</axis>
	</animation>

</PropertyList>
