<?xml version="1.0"?>
<PropertyList>
	<name>instr_sys_dialog</name>
	<layout>vbox</layout>
	<default-padding>5</default-padding>
	<modal>false</modal>
	<width>250</width>
	<group>
		<layout>hbox</layout>
		<empty>
			<stretch>true</stretch>
		</empty>
		<text>
			<label>Instrumentation Systems</label>
		</text>
		<empty>
			<stretch>true</stretch>
		</empty>
		<button>
			<legend/>
			<key>Esc</key>
			<pref-width>16</pref-width>
			<pref-height>16</pref-height>
			<border>2</border>
			<binding>
				<command>dialog-close</command>
			</binding>
		</button>
	</group>
	<hrule/>
	<text>
		<label>Pitot System</label>
	</text>
	<group>
		<layout>hbox</layout>
		<checkbox>
			<property>/systems/pitot/failures/line-broken</property>
			<live>true</live>
			<binding>
				<command>dialog-apply</command>
			</binding>
		</checkbox>
		<text>
			<label>Internal Lines Broken</label>
		</text>
	</group>
	<text>
		<label>Pitot Blockage</label>
	</text>
	<group>
		<layout>hbox</layout>
		<slider>
			<property>/systems/pitot/failures/blockage-total</property>
			<live>true</live>
			<binding>
				<command>dialog-apply</command>
			</binding>
		</slider>
		<text>
			<label>Total</label>
		</text>
	</group>
	<group>
		<layout>hbox</layout>
		<slider>
			<property>/systems/pitot/failures/blockage-free-drain</property>
			<live>true</live>
			<binding>
				<command>dialog-apply</command>
			</binding>
		</slider>
		<text>
			<label>In Front of Drain Hole</label>
		</text>
	</group>
	<hrule/>
	<text>
		<label>Static System</label>
	</text>
	<group>
		<layout>hbox</layout>
		<checkbox>
			<property>/systems/static/failures/line-broken</property>
			<live>true</live>
			<binding>
				<command>dialog-apply</command>
			</binding>
		</checkbox>
		<text>
			<label>Internal Lines Broken</label>
		</text>
	</group>
	<text>
		<label>Static Vent Blockage</label>
	</text>
	<group>
		<layout>hbox</layout>
		<slider>
			<property>/systems/static/failures/blockage-left</property>
			<live>true</live>
			<binding>
				<command>dialog-apply</command>
			</binding>
		</slider>
		<text>
			<label>Left</label>
		</text>
	</group>
	<group>
		<layout>hbox</layout>
		<slider>
			<property>/systems/static/failures/blockage-right</property>
			<live>true</live>
			<binding>
				<command>dialog-apply</command>
			</binding>
		</slider>
		<text>
			<label>Right</label>
		</text>
	</group>
</PropertyList>
