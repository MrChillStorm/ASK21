				<y>0.0</y>
				<z>0.2</z>
			</position>
			<reference-dist>2</reference-dist>
			<max-dist>10</max-dist>
		</wheel-spin>

		<wheel-spin>
			<name>wheel-spin-tail</name>
			<mode>looped</mode>
			<path>wheelspin-loop.wav</path>
			<property>gear/gear[2]/rollspeed-ms</property>
