		<!--ILEC SC7 electric vario based on http://www.ilec-gmbh.com/ilec/manuals/SC7_Handbuch_d_2014.pdf-->
		<variometer-up>
			<name>variometer-up</name>
			<mode>looped</mode>
			<path>vario.wav</path>
			<condition>
				<and>
					<greater-than>
						<property>instrumentation/variometer/te-reading-mps</property>
						<value>0.01</value>
					</greater-than>
					<greater-than-equals>
						<property>systems/electrical/outputs/ilec-sc7</property>
						<value>9</value>
					</greater-than-equals>
					<greater-than>
						<property>instrumentation/ilec-sc7/audio</property>
						<value>0</value>
					</greater-than>
				</and>
			</condition>
			<pitch>
				<property>instrumentation/variometer/te-reading-mps</property>
				<factor>0.075</factor>
				<offset>1.0</offset>
			</pitch>
			<volume>
				<property>instrumentation/ilec-sc7/volume</property>
				<factor>1</factor>
				<max>1</max>
			</volume>
			<position>
				<x>-3.35</x>
				<y>0</y>
				<z>0.7</z>
			</position>
			<reference-dist>0.5</reference-dist>
			<max-dist>2.0</max-dist>
		</variometer-up>

		<variometer-down>
			<name>variometer-down</name>
			<mode>looped</mode>
			<path>vario2.wav</path>
			<condition>
				<and>
					<greater-than>
						<property>instrumentation/variometer/te-reading-mps</property>
						<value>-10.00</value>
					</greater-than>
					<and>
						<less-than>
							<property>instrumentation/variometer/te-reading-mps</property>
							<value>-0.01</value>
						</less-than>
					</and>
					<equals>
						<property>instrumentation/ilec-sc7/audio</property>
						<value>2</value>
					</equals>
					<greater-than-equals>
						<property>systems/electrical/outputs/ilec-sc7</property>
						<value>9</value>
					</greater-than-equals>
				</and>
			</condition>
			<pitch>
				<property>instrumentation/variometer/te-reading-mps</property>
				<factor>0.075</factor>
				<offset>1.0</offset>
			</pitch>
			<volume>
				<property>instrumentation/ilec-sc7/volume</property>
				<factor>1</factor>
				<max>1</max>
			</volume>
			<position>
				<x>-3.35</x>
				<y>0</y>
				<z>0.7</z>
			</position>
			<reference-dist>0.5</reference-dist>
			<max-dist>2.0</max-dist>
		</variometer-down>

