			<volume>
				<property>gear/gear[0]/rollspeed-ms</property>
				<factor>0.02</factor>
			</volume>
			<pitch>
				<property>gear/gear[0]/rollspeed-ms</property>
				<factor>0.01</factor>
				<offset>1</offset>
			</pitch>
			<position>
				<x>-3.2</x>
				<y>0.0</y>
				<z>0.2</z>
			</position>
			<reference-dist>2</reference-dist>
			<max-dist>10</max-dist>
		</wheel-spin>

		<wheel-spin>
			<name>wheel-spin-main</name>
			<mode>looped</mode>
