		<airbrakes>
			<name>airbrakes</name>
			<mode>looped</mode>
			<path>airbrakesL.wav</path>
			<property>velocities/airspeed-kt</property>
			<volume>
				<property>surface-positions/speedbrake-pos-norm</property>
				<factor>0.6</factor>
				<offset>0.0</offset>
				<min>0.0</min>
				<max>0.5</max>
			</volume>
			<volume>
				<property>velocities/airspeed-kt</property>
				<factor>0.015</factor>
				<min>0.00</min>
				<max>0.5</max>
				<offset>-0.1</offset>
			</volume>
			<pitch>
				<property>velocities/airspeed-kt</property>
				<factor>0.002</factor>
				<offset>1</offset>
			</pitch>
		</airbrakes>

		<airbrake-open>
			<name>airbrake-open</name>
			<mode>once</mode>
			<path>airbrake-open.wav</path>
			<condition>
				<greater-than>
					<property>surface-positions/speedbrake-pos-norm</property>
					<value>0.06</value>
				</greater-than>
			</condition>
			<position>
				<x>-1.2</x>
				<y>0.0</y>
				<z>1</z>
			</position>
			<reference-dist>2</reference-dist>
			<max-dist>10</max-dist>
		</airbrake-open>

		<airbrake-close>
			<name>airbrake-close</name>
			<mode>once</mode>
			<path>airbrake-close.wav</path>
			<condition>
				<less-than>
					<property>surface-positions/speedbrake-pos-norm</property>
					<value>0.04</value>
				</less-than>
			</condition>
			<position>
				<x>-1.2</x>
				<y>0.0</y>
				<z>1</z>
			</position>
