		<wheelbrake>
			<name>wheelbrake</name>
			<mode>looped</mode>
			<path>wheelbrake.wav</path>
			<condition>
				<and>
					<property>gear/gear[1]/wow</property>
					<greater-than>
						<property>fcs/wheelbrake-cmd</property>
						<value>0.05</value>
					</greater-than>
				</and>
			</condition>
			<volume>
				<property>velocities/groundspeed-kt</property>
				<factor>0.05</factor>
			</volume>
		</wheelbrake>

		<!-- Wind Outside -->
		<wind>
			<name>wind</name>
			<mode>looped</mode>
			<path>Sounds/wind.wav</path>
			<property>velocities/airspeed-kt</property>
			<condition>
				<not>
					<property>/sim/current-view/internal</property>
				</not>
			</condition>
			<volume>
				<property>position/altitude-ft</property>
				<factor>-0.000015</factor>
				<offset>1.0</offset>
				<min>0.1</min>
				<max>1.0</max>
			</volume>
			<volume>
				<property>velocities/airspeed-kt</property>
				<factor>0.005</factor>
				<min>0.0</min>
				<max>1</max>
				<offset>-0.2</offset>
			</volume>
			<pitch>
				<property>velocities/airspeed-kt</property>
				<factor>0.01</factor>
				<offset>1</offset>
			</pitch>
		</wind>

		<!--Wind in cockpit - front-->
		<wind>
			<name>wind front</name>
			<mode>looped</mode>
