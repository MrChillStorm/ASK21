				<factor>1.0</factor>
			</volume>
			<pitch>
				<property>velocities/airspeed-kt</property>
				<factor>0.01</factor>
				<offset>1.1</offset>
			</pitch>
			<position>
				<x>-2.8</x>
				<y>0.0</y>
				<z>0.8</z>
			</position>
			<reference-dist>0.5</reference-dist>
			<max-dist>2</max-dist>
		</wind>

