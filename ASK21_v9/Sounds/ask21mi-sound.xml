<?xml version="1.0"?>

<PropertyList include="ask21-sound.xml">
	<fx>
		<crank>
			<name>engstart</name>
			<path>Sounds/engstart.wav</path>
			<property>engines/engine[0]/cranking</property>
			<volume>
				<offset>0.25</offset>
			</volume>
		</crank>
		<crank>
			<name>crank</name>
			<mode>looped</mode>
			<path>Sounds/cranking.wav</path>
			<condition>
				<property>engines/engine[0]/cranking</property>
				<not>
					<property>engines/engine[0]/running</property>
				</not>
			</condition>
			<volume>
				<offset>0.25</offset>
			</volume>
		</crank>
		<crank>
			<name>cough</name>
			<path>Sounds/coughing.wav</path>
			<property>engines/engine[0]/running</property>
			<volume>
				<offset>0.25</offset>
			</volume>
		</crank>

		<engine>
			<name>engine</name>
			<mode>looped</mode>
			<path>engine.wav</path>
			<property>engines/engine[0]/running</property>
			<volume>
				<property>engines/engine[0]/mp-osi</property>
				<factor>0.00375</factor>
				<min>0.15</min>
				<max>0.5</max>
			</volume>
			<volume>
				<property>/sim/current-view/internal</property>
				<offset>1.0</offset>
				<factor>-0.7</factor>
			</volume>
			<pitch>
				<property>/engines/engine[0]/rpm</property>
				<factor>0.0002</factor>
				<min>0.5</min>
				<max>2.0</max>
				<offset>0.15</offset>
			</pitch>
		</engine>

	</fx>
</PropertyList>
