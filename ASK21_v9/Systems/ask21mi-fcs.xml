<system name="ASK21: FCS">
	<!-- the wake of an aircraft ahead (the tug), written by Nasal/propwash.nas and read by the aerodynamics
	     (aero/v9/wash/*): slipstream centre, radius, speed, swirl and turbulence; trailing vortex positions,
	     circulation and core. All zero: no wake. -->
	<property value="0">aero/v9/wash/y-ft</property>
	<property value="0">aero/v9/wash/z-ft</property>
	<property value="0">aero/v9/wash/r-ft</property>
	<property value="0">aero/v9/wash/u-fps</property>
	<property value="0">aero/v9/wash/swirl-fps</property>
	<property value="0">aero/v9/wash/turb-u-fps</property>
	<property value="0">aero/v9/wash/turb-v-fps</property>
	<property value="0">aero/v9/wash/turb-w-fps</property>
	<property value="0">aero/v9/wash/turb-roll-fps</property>
	<property value="0">aero/v9/wash/vr-y-ft</property>
	<property value="0">aero/v9/wash/vr-z-ft</property>
	<property value="0">aero/v9/wash/vl-y-ft</property>
	<property value="0">aero/v9/wash/vl-z-ft</property>
	<property value="0">aero/v9/wash/gamma-ft2_sec</property>
	<property value="0">aero/v9/wash/core-ft</property>

	<channel name="Speed Brake">

		<fcs_function name="fcs/speedbrake-int-norm">
			<function>
				<table>
					<independentVar lookup="row">/controls/flight/spoilers</independentVar>
					<tableData>
						0	0
						0.9	1
						1	1
					</tableData>
				</table>
			</function>
		</fcs_function>

	</channel>
	<channel name="Wheel Brake">

		<fcs_function name="fcs/wheelbrake-cmd">
			<function>
				<table>
					<independentVar lookup="row">/controls/flight/spoilers</independentVar>
					<tableData>
						0	0
						0.9	0
						1	1
					</tableData>
				</table>
			</function>
			<output>/fcs/wheelbrake-cmd</output> <!-- for sound/YASim compatibility -->
		</fcs_function>

		<kinematic name="rubbish/brake">
			<input>fcs/wheelbrake-cmd</input>
			<traverse>
				<setting>
					<position>0</position>
					<time>0</time>
				</setting>
				<setting>
					<position>1</position>
					<time>0</time>
				</setting>
			</traverse>
			<output>fcs/left-brake-cmd-norm</output>
		</kinematic>


	</channel>
	<channel name="Mixture">

		<fcs_function name="fcs/mixture-cmd-modified">
			<function>
				<value>1</value>
			</function>
			<output>fcs/mixture-cmd-norm[0]</output>
			<output>fcs/mixture-pos-norm[0]</output>
		</fcs_function>
		
		

	</channel>

	<channel name="Ground Handling">

		<fcs_function name="external_reactions/turn/magnitude">
			<function>
				<product>
					<property>/systems/groundhandling/rudder</property>
					<value>200</value>
				</product>
			</function>
		</fcs_function>

		<fcs_function name="external_reactions/pull/magnitude">
			<function>
				<product>
					<property>/systems/groundhandling/throttle</property>
					<value>200</value>
				</product>
			</function>
		</fcs_function>


		<kinematic name="rubbish/gear-pos-norm">
			<input>/systems/groundhandling/wingholder</input>
			<traverse>
				<setting>
					<position>0</position>
					<time>0</time>
				</setting>
				<setting>
					<position>1</position>
					<time>0</time>
				</setting>
			</traverse>
			<output>gear/gear-pos-norm</output>
		</kinematic>
	</channel>
	
	<property value="1">/controls/engines/engine[0]/propeller-brake</property>
	
	<channel name="Engine">
		<fcs_function name="fcs/propeller-brake">
			<function>
				<table>
					<independentVar lookup="row">/controls/engines/engine[0]/propeller-brake</independentVar>
					<tableData>
						0	0.27
						1	15
					</tableData>
				</table>
			</function>
			<output>propulsion/engine[0]/friction-hp</output>
		</fcs_function>
		
		<pure_gain>
			<input>/controls/engines/engine/throttle-int</input>
			<gain>1.0</gain>
			<output>fcs/throttle-cmd-norm</output>
			<output>fcs/throttle-pos-norm</output>
		</pure_gain>
	</channel>
</system>
