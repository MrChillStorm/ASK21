<?xml version="1.0"?>

<PropertyList>
	<filter>
		<type>gain</type>
		<gain>1</gain>
		<input>
			<condition>
				<equals>
					<property>/sim/flight-model</property>
					<value>jsb</value>
				</equals>
			</condition>
			<expression>
				<product>
					<property>/instrumentation/airspeed-indicator/indicated-speed-kt</property>
					<table>
						<property>/fdm/jsbsim/aero/beta-deg</property>
						<!-- in a full slip the indication goes to zero (flight manual IV.8) -->
						<entry><ind>-40</ind><dep>0</dep></entry>
						<entry><ind>-35</ind><dep>0.05</dep></entry>
						<entry><ind>-25</ind><dep>0.2</dep></entry>
						<entry><ind>-8</ind><dep>0.9</dep></entry>
						<entry><ind>-3</ind><dep>1</dep></entry>
						<entry><ind>0</ind><dep>1</dep></entry>
						<entry><ind>3</ind><dep>1</dep></entry>
						<entry><ind>8</ind><dep>0.9</dep></entry>
						<entry><ind>25</ind><dep>0.2</dep></entry>
						<entry><ind>35</ind><dep>0.05</dep></entry>
						<entry><ind>40</ind><dep>0</dep></entry>
					</table>
					<sum>
						<product>
							<!-- If Pitot extension not installed: indication 22 kts too low in inverted flight
								assume:
									1) 22 kts too low at normal inverted flight speed (100 kts)
									2) inverted flight = alpha between -3 and -8
							-->
							<difference>
								<value>1</value>
								<property>/sim/model/pitot-extension</property>
							</difference>
							<table>
								<property>/fdm/jsbsim/aero/alpha-deg</property>
								<entry><ind>-8</ind><dep>0.78</dep></entry>
								<entry><ind>-4</ind><dep>0.8 </dep></entry>
								<entry><ind>-3</ind><dep>1.0 </dep></entry>
							</table>
						</product>
						<property>/sim/model/pitot-extension</property>
					</sum>
				</product>
			</expression>
		</input>
		<input>
			<condition>
				<equals>
					<property>/sim/flight-model</property>
					<value>yasim</value>
				</equals>
			</condition>
			<property>/instrumentation/airspeed-indicator/indicated-speed-kt</property>
		</input>
		<output>/instrumentation/airspeed-indicator/indicated-corr-speed-kt</output>
	</filter>
	<filter>
		<type>gain</type>
		<gain>1</gain>
		<input>
			<condition>
				<equals>
					<property>/sim/flight-model</property>
					<value>jsb</value>
				</equals>
			</condition>
			<expression>
				<product>
					<property>/instrumentation/airspeed-indicator[1]/indicated-speed-kt</property>
					<table>
						<property>/fdm/jsbsim/aero/beta-deg</property>
						<!-- in a full slip the indication goes to zero (flight manual IV.8) -->
						<entry><ind>-40</ind><dep>0</dep></entry>
						<entry><ind>-35</ind><dep>0.05</dep></entry>
						<entry><ind>-25</ind><dep>0.2</dep></entry>
						<entry><ind>-8</ind><dep>0.9</dep></entry>
						<entry><ind>-3</ind><dep>1</dep></entry>
						<entry><ind>0</ind><dep>1</dep></entry>
						<entry><ind>3</ind><dep>1</dep></entry>
						<entry><ind>8</ind><dep>0.9</dep></entry>
						<entry><ind>25</ind><dep>0.2</dep></entry>
						<entry><ind>35</ind><dep>0.05</dep></entry>
						<entry><ind>40</ind><dep>0</dep></entry>
					</table>
					<sum>
						<product>
							<!-- If Pitot extension not installed: indication 22 kts too low in inverted flight
								assume:
									1) 22 kts too low at normal inverted flight speed (100 kts)
									2) inverted flight = alpha between -3 and -8
							-->
							<difference>
								<value>1</value>
								<property>/sim/model/pitot-extension</property>
							</difference>
							<table>
								<property>/fdm/jsbsim/aero/alpha-deg</property>
								<entry><ind>-8</ind><dep>0.78</dep></entry>
								<entry><ind>-4</ind><dep>0.8 </dep></entry>
								<entry><ind>-3</ind><dep>1.0 </dep></entry>
							</table>
						</product>
						<property>/sim/model/pitot-extension</property>
					</sum>
				</product>
			</expression>
		</input>
		<input>
			<condition>
				<equals>
					<property>/sim/flight-model</property>
					<value>yasim</value>
				</equals>
			</condition>
			<property>/instrumentation/airspeed-indicator[1]/indicated-speed-kt</property>
		</input>
		<output>/instrumentation/airspeed-indicator[1]/indicated-corr-speed-kt</output>
	</filter>

	<!-- Turn-Slip-Indicator OFF-Flag -->
	<!-- ref. https://www.mcico.com/Assets/products/TechnicalDrawings/5550-8340N3LrevF_td.pdf: 10.6 - 11.6 VDC -->
	<filter>
		<type>noise-spike</type>
		<input>
			<condition>
				<greater-than-equals>
					<property>/systems/electrical/outputs/turn-indicator</property>
					<value>11.6</value>
				</greater-than-equals>
			</condition>
			<value>0.0</value>
		</input>
		<input>1.0</input>
		<max-rate-of-change>2.0</max-rate-of-change>
		<output>/instrumentation/turn-indicator/off-flag-pos</output>
	</filter>
	
	<!-- Anemoi Wind Averager -->
	<filter>
		<type>moving-average</type>
		<samples>4500</samples> <!-- TODO in reality 3 minutes, but FG only accepts number of samples, not time; assume: 25 fps i.e. 4500 samples  -->
		<input>/environment/wind-from-heading-deg</input>
		<output>/instrumentation/anemoi/avg-wind-from-heading-deg</output>
	</filter>
	<filter>
		<type>moving-average</type>
		<samples>4500</samples> <!-- TODO in reality 3 minutes, but FG only accepts number of samples, not time; assume: 25 fps i.e. 4500 samples  -->
		<input>/environment/wind-speed-kt</input>
		<output>/instrumentation/anemoi/avg-wind-speed-kt</output>
	</filter>
	
	<!-- PITOT and STATIC Line Failures -->
	<filter>
		<type>gain</type>
		<gain>0.0002952998</gain> <!-- convert Pa to inHg -->
		<input>
			<expression>
				<product>
					<value>0.5</value>
					<value>1.2038</value> <!-- density, kg/m3 -->
					<pow>
						<product>
							<property>velocities/vc-kts</property>
							<value>0.5144</value> <!-- kts to mps -->
						</product>
						<value>2</value>
					</pow>
				</product>
			</expression>
		</input>
		<output>/systems/pitot/dynamic-pressure-inhg</output>
	</filter>
	
	<!--	If the static pressure lines break, pressure will be drawn basically from the cabin, which is assumed to have a slightly elevated pressure
	while flying due to air being "pressed into" the cabin by the airspeed through ventilation	-->
	<filter>
		<type>gain</type>
		<gain>1.0</gain>
		<input>
			<expression>
				<sum>
					<property>/systems/static/pressure-inhg</property>
					<product>
						<property>/systems/pitot/dynamic-pressure-inhg</property>
						<value>0.01</value>
					</product>
				</sum>
			</expression>
		</input>
		<output>/systems/static/pressure-inhg-cabin</output>
	</filter>
	<filter>
		<type>gain</type>
		<gain>0.01</gain>
		<input>
			<expression>
				<difference>
					<div>
						<value>1</value>
						<max>
							<difference>
								<sum>
									<property>/systems/static/failures/blockage-left</property>
									<property>/systems/static/failures/blockage-right</property>
								</sum>
								<value>1</value>
							</difference>
							<value>0.0001</value>
						</max>
					</div>
					<value>1</value>
				</difference>
			</expression>
		</input>
		<output>/systems/static/pressure-rate</output>
	</filter>
	<filter>
		<type>noise-spike</type>
		<max-rate-of-change>
			<property>/systems/static/pressure-rate</property>
		</max-rate-of-change>
		<input>/systems/static/pressure-inhg</input>
		<output>/systems/static/pressure-inhg-blockage</output>
	</filter>
	<filter>
		<type>gain</type>
		<gain>1.0</gain>
		<input>
			<condition>
				<equals>
					<property>/systems/static/failures/line-broken</property>
					<value>1</value>
				</equals>
			</condition>
			<property>/systems/static/pressure-inhg-cabin</property>
		</input>
		<input>
			<condition>
				<and>
					<greater-than>
						<property>/systems/static/failures/blockage-left</property>
						<value>0</value>
					</greater-than>
					<greater-than>
						<property>/systems/static/failures/blockage-right</property>
						<value>0</value>
					</greater-than>
				</and>
			</condition>
			<property>/systems/static/pressure-inhg-blockage</property>
		</input>
		<input>/systems/static/pressure-inhg</input>
		<output>/systems/static/pressure-inhg-custom</output>
	</filter>
	<filter>
		<type>gain</type>
		<gain>0.01</gain>
		<input>
			<expression>
				<difference>
					<div>
						<value>1</value>
						<max>
							<property>/systems/pitot/failures/blockage-total</property>
							<value>0.0001</value>
						</max>
					</div>
					<value>1</value>
				</difference>
			</expression>
		</input>
		<output>/systems/pitot/pressure-rate</output>
	</filter>
	<filter>
		<type>gain</type>
		<gain>1.0</gain>
		<input>
			<expression>
				<sum>
					<property>/systems/static/pressure-inhg</property>
					<product>
						<difference>
							<property>/systems/pitot/total-pressure-inhg</property>
							<property>/systems/static/pressure-inhg</property>
						</difference>
						<product>
							<div>
								<value>1</value>
								<max>
									<property>/systems/pitot/failures/blockage-free-drain</property>
									<value>0.0001</value>
								</max>
							</div>
							<value>0.0001</value>
						</product>
					</product>
				</sum>
			</expression>
		</input>
		<output>/systems/pitot/total-pressure-inhg-blockage-raw</output>
	</filter>
	<filter>
		<type>noise-spike</type>
		<max-rate-of-change>
			<property>/systems/pitot/pressure-rate</property>
		</max-rate-of-change>
		<input>/systems/pitot/total-pressure-inhg-blockage-raw</input>
		<output>/systems/pitot/total-pressure-inhg-blockage</output>
	</filter>
	<!--	If the dynamic pressure lines break, pressure will be drawn basically from the cabin, which is assumed to have a slightly elevated static pressure
	while flying due to air being "pressed into" the cabin by the airspeed through ventilation	-->
	<filter>
		<type>gain</type>
		<gain>1.0</gain>
		<input>
			<condition>
				<equals>
					<property>/systems/pitot/failures/line-broken</property>
					<value>1</value>
				</equals>
			</condition>
			<property>/systems/static/pressure-inhg-cabin</property>
		</input>
		<input>
			<condition>
				<equals>
					<property>/sim/model/pitot-cover</property>
					<value>1</value>
				</equals>
			</condition>
			<property>/systems/static/pressure-inhg</property>
		</input>
		<input>
			<condition>
				<or>
					<greater-than>
						<property>/systems/pitot/failures/blockage-total</property>
						<value>0</value>
					</greater-than>
					<greater-than>
						<property>/systems/pitot/failures/blockage-free-drain</property>
						<value>0</value>
					</greater-than>
				</or>
			</condition>
			<property>/systems/pitot/total-pressure-inhg-blockage</property>
		</input>
		<input>/systems/pitot/total-pressure-inhg</input>
		<output>/systems/pitot/total-pressure-inhg-custom</output>
	</filter>
</PropertyList>
