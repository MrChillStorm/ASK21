<?xml version="1.0"?>

<PropertyList>
	<filter>
		<type>gain</type>
		<gain>1.0</gain>

		<input>
			<condition>
				<equals>
					<property>/sim/flight-model</property>
					<value>jsb</value>
				</equals>
			</condition>
			<property>/fdm/jsbsim/aero/qbar-psf</property>
		</input>
		<input>
			<condition>
				<equals>
					<property>/sim/flight-model</property>
					<value>yasim</value>
				</equals>
			</condition>
			<expression>
				<product>
					<!-- dynamic pressure = 0.5 * rho * v^2 -->
					<value>0.5</value>
					<property>/environment/density-slugft3</property> <!-- rho -->
					<pow>
						<product>
							<property>/velocities/airspeed-kt</property>
							<value>1.6878</value> <!-- knots to feet/sec -->
						</product>
						<value>2</value>
					</pow>
				</product>
			</expression>
		</input>
		<output>/sim/model/sound/qbar-psf</output>
	</filter>
	<filter>
		<type>gain</type>
		<gain>1</gain>
		<input>
			<expression>
				<product>
					<sum>
						<value>1</value>
						<product>
							<property>/position/altitude-ft</property>
							<value>-0.000015</value>
						</product>
					</sum>
					<product>
						<property>/sim/model/sound/qbar-psf</property>
						<value>0.08</value>
					</product>
					<table>
						<property>sim/model/door-positions/frontwin/position-norm</property>
						<entry><ind>0.0</ind><dep>0.25</dep></entry>
						<entry><ind>0.1</ind><dep>0.65</dep></entry>
						<entry><ind>1.0</ind><dep>1.00</dep></entry>
					</table>
				</product>
			</expression>
		</input>
		<output>/sim/model/sound/wind-volume-front</output>
	</filter>
	<filter>
		<type>gain</type>
		<gain>1</gain>
		<input>
			<expression>
				<product>
					<sum>
						<value>1</value>
						<product>
							<property>/position/altitude-ft</property>
							<value>-0.000015</value>
						</product>
					</sum>
					<product>
						<property>/sim/model/sound/qbar-psf</property>
						<value>0.08</value>
					</product>
					<table>
						<property>sim/model/door-positions/rearwin/position-norm</property>
						<entry><ind>0.0</ind><dep>0.25</dep></entry>
						<entry><ind>0.1</ind><dep>0.65</dep></entry>
						<entry><ind>1.0</ind><dep>1.00</dep></entry>
					</table>
				</product>
			</expression>
		</input>
		<output>/sim/model/sound/wind-volume-rear</output>
	</filter>
</PropertyList>
