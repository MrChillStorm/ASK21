<?xml version="1.0"?>

<PropertyList>
	<!-- how far each sliding window lets the wind in (0 shut, 1 fully open): the sound file plays the wind through it at
	     its physical level against the airspeed (Sounds/ask21-sound.xml, fdm/airsound.py); a window opened a crack lets
	     in most of it -->
	<filter>
		<type>gain</type>
		<gain>1</gain>
		<input>
			<expression>
				<table>
					<property>sim/model/door-positions/frontwin/position-norm</property>
					<entry><ind>0.0</ind><dep>0.00</dep></entry>
					<entry><ind>0.1</ind><dep>0.65</dep></entry>
					<entry><ind>1.0</ind><dep>1.00</dep></entry>
				</table>
			</expression>
		</input>
		<output>/sim/model/sound/wind-volume-front</output>
	</filter>
	<filter>
		<type>gain</type>
		<gain>1</gain>
		<input>
			<expression>
				<table>
					<property>sim/model/door-positions/rearwin/position-norm</property>
					<entry><ind>0.0</ind><dep>0.00</dep></entry>
					<entry><ind>0.1</ind><dep>0.65</dep></entry>
					<entry><ind>1.0</ind><dep>1.00</dep></entry>
				</table>
			</expression>
		</input>
		<output>/sim/model/sound/wind-volume-rear</output>
	</filter>
</PropertyList>
