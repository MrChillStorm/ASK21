<?xml version="1.0"?>

<PropertyList>

	<!-- generated by fdm/flexwing.py: the below-wing and wingtip cameras ride on the wing, at 7 and 96 % of the
	     tip deflection (sim/model/wingflex/*-m, from the flight model) -->
	<filter>
		<type>gain</type>
		<gain>1</gain>
		<enable><condition><equals><property>/sim/current-view/view-number-raw</property><value>100</value></equals></condition></enable>
		<input><expression><sum><value>0.7000</value><product><value>0.0695</value><property>/sim/model/wingflex/left-m</property></product></sum></expression></input>
		<output>/sim/current-view/y-offset-m</output>
	</filter>
	<filter>
		<type>gain</type>
		<gain>1</gain>
		<enable><condition><equals><property>/sim/current-view/view-number-raw</property><value>101</value></equals></condition></enable>
		<input><expression><sum><value>1.5000</value><product><value>0.9643</value><property>/sim/model/wingflex/right-m</property></product></sum></expression></input>
		<output>/sim/current-view/y-offset-m</output>
	</filter>

</PropertyList>
