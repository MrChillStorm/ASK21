	<input>
		<keyboard include="Aircraft/Generic/hitch-keyboard.xml">
			<key n="127">
				<name>Delete</name>
				<desc>Toggle Reversers</desc>
				<binding>
					<condition>
						<equals>
							<property>controls/engines/engine[0]/throttle</property>
							<value>0</value>
						</equals>
					</condition>
					<command>property-toggle</command>
					<property>controls/engines/engine[0]/reverser</property>
				</binding>
			</key>
			<key n="68">
				<name>D</name>
				<desc>Toggle Both Windows</desc>
				<binding>
					<condition>
						<less-than>
							<property>sim/model/door-positions/frontwin/position-norm</property>
							<value>0.5</value>
						</less-than>
					</condition>
					<command>property-interpolate</command>
					<property>sim/model/door-positions/frontwin/position-norm</property>
					<value type="double">1.0</value>
					<rate>0.5</rate>
				</binding>
				<binding>
					<condition>
						<greater-than-equals>
							<property>sim/model/door-positions/frontwin/position-norm</property>
							<value>0.5</value>
						</greater-than-equals>
					</condition>
					<command>property-interpolate</command>
					<property>sim/model/door-positions/frontwin/position-norm</property>
					<value type="double">0.0</value>
					<rate>0.5</rate>
				</binding>
				<binding>
					<!-- using frontwin in the conditional for readwin in order to synchronize both windows positions -->
					<condition>
						<less-than>
							<property>sim/model/door-positions/frontwin/position-norm</property>
							<value>0.5</value>
						</less-than>
					</condition>
					<command>property-interpolate</command>
					<property>sim/model/door-positions/rearwin/position-norm</property>
					<value type="double">1.0</value>
					<rate>0.5</rate>
				</binding>
				<binding>
					<condition>
						<greater-than-equals>
							<property>sim/model/door-positions/frontwin/position-norm</property>
							<value>0.5</value>
						</greater-than-equals>
					</condition>
					<command>property-interpolate</command>
					<property>sim/model/door-positions/rearwin/position-norm</property>
					<value type="double">0.0</value>
					<rate>0.5</rate>
				</binding>
			</key>
			<key n="83">
				<name>S</name>
				<desc>Vario volume up</desc>
				<binding>
					<command>property-adjust</command>
					<property>/instrumentation/ilec-sc7/volume</property>
					<step>0.1</step>
					<max>1</max>
				</binding>
			</key>
			<key n="115">
				<name>s</name>
				<desc>Vario volume down</desc>
				<binding>
					<command>property-adjust</command>
					<property>/instrumentation/ilec-sc7/volume</property>
					<step>-0.1</step>
					<min>0</min>
				</binding>
			</key>
			<key n="19">
				<name>Ctrl-s</name>
				<desc>Start/stop smoke</desc>
				<binding>
					<command>property-toggle</command>
					<property>controls/smoke</property>
				</binding>
			</key>
			<key n="2">
				<name>Ctrl-b</name>
				<desc>Electric Master Switch on/off</desc>
				<binding>
					<command>property-toggle</command>
					<property>/controls/electric/battery-switch</property>
				</binding>
			</key>
			<key n="20">
				<name>Ctrl-t</name>
				<desc>Turn Coordinator Switch on/off</desc>
				<binding>
					<command>property-toggle</command>
					<property>/controls/electric/turn-slip-switch</property>
				</binding>
			</key>
			<!--Helper Functions-->
			<key n="117">
				<name>u</name>
				<desc>Show current QNH and current pressure</desc>
				<binding>
					<command>nasal</command>
					<script>
						var qnh = getprop("/environment/pressure-sea-level-inhg")*33.8638867;
						var cp = getprop("environment/pressure-inhg")*33.8638867;
						gui.popupTip(sprintf("Current QNH %d, current pressure (QFE when on ground) %d", qnh, cp));
					</script>
				</binding>
			</key>
			<key n="81">
				<name>Q</name>
				<desc>Show current wind data</desc>
				<binding>
					<command>nasal</command>
					<script>ask21.windcheck();</script>
				</binding>
			</key>
		</keyboard>
