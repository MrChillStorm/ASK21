		<!-- Save some properties when the simulator is shut down -->
		<aircraft-data>
			<path>/sim/model/window</path>
			<path>/sim/model/window-shader</path>
			<path>/sim/model/pilots-enabled</path>
			<path>/sim/model/pilots-always-present</path>
			<path>/sim/model/instruments-light</path>
			<path>/sim/model/windcompass</path>
			<path>/sim/model/transponder</path>
			<path>/sim/model/joystick-release</path>
			<path>/instrumentation/lxv8/settings</path>
			<path>/sim/weight[0]/weight-lb</path>
			<path>/sim/weight[1]/weight-lb</path>
			<path>/sim/glider/propwash/strength</path>
		</aircraft-data>
		<hitches>
			<!-- make sure some properties do exist, when the list for multiplayer transfere is defined-->
			<!-- they need to be in the same value, as they are initialized in the FDM, to get the same values after reset should fix this somehow-->
			<hook-open type="bool">false</hook-open>
			<aerotow>
				<force-is-calculated-by-other type="bool">false</force-is-calculated-by-other>
				<mp-auto-connect-period type="float">0.0</mp-auto-connect-period>
				<tow>
					<length type="float">50</length> <!-- m, unstretched; under tow it stretches to about 60 m (the default would be 60 m unstretched) -->
					<break-force type="float">6000</break-force> <!-- ref. POH, I.5 -->
				</tow>
			</aerotow>
			<winch>
				<automatic-release-angle-deg type="float">70.</automatic-release-angle-deg>
				<tow>
					<break-force type="float">10000</break-force> <!-- ref. POH, I.5 -->
				</tow>
			</winch>
		</hitches>
		<instrumentation>
			<path>Systems/ask21-instrumentation.xml</path>
		</instrumentation>
		<menubar>
			<default>
				<menu n="10">
					<label>ASK21</label>
					<enabled type="bool">true</enabled>
					<item>
						<label>Hitch Settings</label>
						<binding>
							<command>dialog-show</command>
							<dialog-name>hitch_dialog</dialog-name>
						</binding>
					</item>
					<item>
						<label>Drag Robot</label>
						<binding>
							<command>dialog-show</command>
							<dialog-name>dragrobot_dialog</dialog-name>
						</binding>
					</item>
					<item>
						<label>Winch Failures</label>
						<binding>
							<command>dialog-show</command>
							<dialog-name>winch_failure_dialog</dialog-name>
						</binding>
					</item>
					<item>
						<label>Simulation Options</label>
						<binding>
							<command>dialog-show</command>
							<dialog-name>options_dialog</dialog-name>
						</binding>
					</item>
					<item>
						<label>Ground services</label>
						<binding>
							<command>dialog-show</command>
							<dialog-name>groundservice_dialog</dialog-name>
						</binding>
					</item>
					<item>
						<label>Electrical</label>
						<binding>
							<command>dialog-show</command>
							<dialog-name>electrical_dialog</dialog-name>
						</binding>
					</item>
					<item>
						<label>LXNAV V8 close-up</label>
						<binding>
							<command>nasal</command>
							<script>lxv8.toggle_window()</script>
						</binding>
					</item>
					<item>
						<label>Select Livery</label>
						<binding>
							<command>nasal</command>
							<script>aircraft.livery.dialog.open()</script>
						</binding>
					</item>
					<item>
						<label>Select Immatriculation</label>
						<binding>
							<command>dialog-show</command>
							<dialog-name>Immatriculation</dialog-name>
						</binding>
					</item>
					<item>
						<label>Training Options</label>
						<binding>
							<command>dialog-show</command>
							<dialog-name>training_dialog</dialog-name>
						</binding>
					</item>
					<item>
						<label>Instrument Failures</label>
						<binding>
							<command>dialog-show</command>
							<dialog-name>instr_sys_dialog</dialog-name>
						</binding>
					</item>
					<item>
						<name>mpcopilot</name>
						<label>Select MP Copilot</label>
						<binding>
							<command>nasal</command>
							<script>
								dual_control_tools.copilot_dialog.show(aircraft_dual_control.copilot_type);
							</script>
						</binding>
					</item>
				</menu>
			</default>
		</menubar>
		<model>
			<path archive="y">Aircraft/ASK21_v9/Models/ask21.xml</path>
			<window type="bool">1</window> <!--Enable window visibility by default-->
			<window-shader type="bool">1</window-shader><!--Enable window shader by default-->
			<pilots-enabled type="bool">1</pilots-enabled><!--Enable pilot models by default-->
			<pilots-always-present type="bool">0</pilots-always-present><!--Disable pilot models always present by default-->
			<instruments-light type="int">0</instruments-light><!--Disable fake instrument lights by default-->
			<windcompass type="bool">0</windcompass><!--Disable Windcompass by default-->
			<transponder type="bool">1</transponder><!--Transponder takes the place of the turn indicator-->
			<pitot-extension type="bool">0</pitot-extension>
			<pitot-cover type="bool">0</pitot-cover>
			<windows>
				<!--Starting with windows opened is more realistic,
				because it's needed to open the canopy from the outside,
				so it's usually open when you sit in-->
				<left type="float">1.0</left>
				<small-left type="float">0.0</small-left> <!-- small vent-type inset window -->
				<right type="float">1.0</right>
			</windows>
			<livery>
				<file type="string">D-3981</file>
				<show-immat type="bool">false</show-immat>
				<instruments>
					<asi>0</asi>
					<alt>0</alt>
					<vsi>0</vsi>
				</instruments>
			</livery>
		</model>
		<multiplay>
			<chat_display>1</chat_display>
			<generic>
				<int   n="0"  type="int">  0 </int>                                         <!--  0 immat -->
				<int   n="1"  type="int">  0 </int>                                         <!--  1 immat -->
				<int   n="2"  type="int">  0 </int>                                         <!--  2 immat -->
				<int   n="3"  type="int">  0 </int>                                         <!--  3 immat -->
				<int   n="4"  type="int">  0 </int>                                         <!--  4 immat -->
				<int   n="5"  type="int">  0 </int>                                         <!--  5 immat -->
				<int   n="6"  type="int"  alias="/sim/model/livery/show-immat"/>
				<int   n="7"  type="int"  alias="/controls/smoke"/>
				<int   n="8"  type="int"  alias="/gear/gear[0]/wow/"/>
				<int   n="9"  type="int"  alias="/gear/gear[1]/wow/"/>
				<int   n="10" type="int"  alias="/gear/gear[2]/wow/"/>
				<int   n="11" type="int"  alias="/sim/model/variant"/>
				<!-- int[12-13] used for -MI variant -->
				
				<float n="0"  alias="/sim/model/door-positions/canopyF/position-norm"/>     <!-- 0 Canopy Front-->
				<float n="1"  alias="/sim/model/door-positions/canopyFJ/position-norm"/>    <!-- 1 Canopy Front JETTISON-->
				<float n="2"  alias="/sim/model/door-positions/canopyB/position-norm"/>     <!-- 2 Canopy Rear-->
				<float n="3"  alias="/sim/model/door-positions/frontwin/position-norm"/>    <!-- 3 Window Front-->
				<float n="4"  alias="/sim/model/door-positions/rearwin/position-norm"/>     <!-- 4 Window Rear-->
				<float n="5"  alias="/gear/gear[0]/rollspeed-ms"/>
				<float n="6"  alias="/gear/gear[1]/rollspeed-ms"/>
				<float n="7"  alias="/gear/gear[2]/rollspeed-ms"/>
				<float n="8"  alias="/sim/systems/wingflexer/z-m"/>
