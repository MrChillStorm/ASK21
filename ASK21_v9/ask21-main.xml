				<float n="13"  alias="/sim/model/sound/wind-volume-front"/>
				<float n="14"  alias="/sim/model/sound/wind-volume-rear"/>
				
				<!-- For Bombable -->
				<int   n="10" type="int"/>
				<string n="9" type="string"/>
			</generic>
		</multiplay>
